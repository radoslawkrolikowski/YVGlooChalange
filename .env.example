# Round — environment variables
#
# Copy to .env.local for local development: cp .env.example .env.local
# The same variables must be set in the Vercel project (Settings → Environment
# Variables) for Production and Preview environments. Placeholder values are
# fine until the step that uses each variable is implemented.

# --- Gloo AI Studio (all AI/agent calls; the only LLM gateway).
#     Create under Studio -> API Credentials -> "Create New Key"; the pair is
#     exchanged for a 1-hour bearer token automatically by src/lib/gloo.ts. ---
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=

# --- YouVersion Platform API (Bible text, versions, highlights) ---
YOUVERSION_API_KEY=

# --- Sign In with YouVersion (OAuth 2.0, NextAuth — Step 6).
#     YouVersion is a PKCE public client: the OAuth client_id IS the app key,
#     so YOUVERSION_OAUTH_CLIENT_ID can stay empty (it falls back to
#     YOUVERSION_API_KEY) and there is no client secret. The app's redirect
#     URI must be registered in YouVersion Platform settings:
#       local:      http://localhost:3000/api/auth/callback/youversion
#       production: https://<your-domain>/api/auth/callback/youversion ---
YOUVERSION_OAUTH_CLIENT_ID=

# --- NextAuth session/CSRF signing secret (Step 6; generate with:
#     openssl rand -base64 32). Required locally and in Vercel. ---
AUTH_SECRET=

# --- Vercel Cron authentication (scheduled agent routes verify this bearer
#     token; generate with: openssl rand -hex 32) ---
CRON_SECRET=

# --- PostgreSQL connection string
#     Local: Docker Postgres from docker-compose.yml — use
#       postgres://round:round@localhost:5433/round
#     Production: Vercel Postgres (Neon), injected automatically when the
#     database is linked to the project. ---
DATABASE_URL=postgres://round:round@localhost:5433/round

# --- Resend (transactional email, production only; local dev uses Mailpit
#     via Docker from Step 2 onward) ---
RESEND_API_KEY=

# --- Instant Access anonymous session signing secret (Step 8; generate with:
#     openssl rand -hex 32). Tokens live only in browser sessionStorage; this
#     secret stops them being forged or altered. ---
ANON_SESSION_SECRET=
